  "services": [
    {
      "name": "24/7 concierge",
      "description": "Our concierge team helps maintain a secure and welcoming environment by managing access to the building, supporting visitors and deliveries, and ensuring residents can enjoy their homes with confidence and privacy."
    },
    {
      "name": "From day one",
      "description": "Everything you need will be set up automatically for as soon as you move in. All documents can be signed electronically. Additional add-ons include a selection of customised kitchen and linen packs."
    },
    {
      "name": "Highly connected",
      "description": "Being fully, reliably, digitally connected has never been more important. Huna Heights offers industry-leading broadband connectivity, with 1 Gbps broadband included as standard for all residents. As the first residential building in the UK to be awarded Platinum-level WiredScore accreditation,…"
    },
    {
      "name": "Your life, made easy",
      "description": "Huna Heights offers a range of services to make life easier, including uninterrupted mobile network connectivity in the lifts, complimentary Wi-Fi in all common areas, free access to hundreds of magazines and newspapers, car club membership, bicycle parking and much more."
    },
    {
      "name": "Safe and secure",
      "description": "The latest security technology is used for access throughout Huna Heights, so wherever you are in the building you can have complete peace of mind at all times. Our teams of security professionals are on hand 24/7 for additional convenience, with external patrols and extensive CCTV across the…"
    },
    {
      "name": "Residents’ portal app",
      "description": "With the press of a button, you can reserve the private dining room, book a swimming session or get immediate access to the latest local area offers."
    },
    {
      "name": "Kitchen and dining",
      "description": "From pots and pans to crockery, cutlery and glassware – all the tools you need to serve up a feast from day one."
    },
    {
      "name": "Bedding and linens",
      "description": "Wrap yourself in the softest towels and sink into the finest sheets – that’s the way to finish moving-in day."
    },
    {
      "name": "Housekeeping",
      "description": "Ease off on the chores – with optional cleaning, laundry, shoe-shine services and more – it’s just another load off your mind."
    }
  ],
  "amenities": [
    {
      "name": "Above it all",
      "description": "Whether for a few laps or a quick dip, the heated, 18-metre rooftop pool is the ultimate soul soother - 27 storeys above the city. Offset with luxurious sun loungers and all made especially easy with convenient changing rooms and outdoor showers."
    },
    {
      "name": "Urban oasis",
      "description": "Unwind in the double-height orangery and airy terrace on the 16th floor. With coffee available for residents, it’s one of the building’s many restorative and welcoming spaces."
    },
    {
      "name": "Quality screen time",
      "description": "With Dolby Atmos surround sound and exceptional 4K projection, movie-night takes on a whole new meaning when the big screen is only a lift ride away in the exclusive 15-seat cinema."
    },
